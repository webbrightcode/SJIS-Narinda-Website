# ==============================================================================
# SJIS Narinda - Production Environment Configuration
# Domain: narinda.sjis.edu.bd
# ==============================================================================

# --- Django Security & Hosts ---
DEBUG=False
DJANGO_SECRET_KEY=sjis-narinda-production-secret-key-928374-ultra-secure-2026
ALLOWED_HOSTS=narinda.sjis.edu.bd,www.narinda.sjis.edu.bd,localhost,127.0.0.1,backend,web

# --- Domain & Cross-Origin Configuration ---
FRONTEND_URL=https://narinda.sjis.edu.bd
CORS_ALLOWED_ORIGINS=https://narinda.sjis.edu.bd,http://narinda.sjis.edu.bd,https://www.narinda.sjis.edu.bd,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://narinda.sjis.edu.bd,http://narinda.sjis.edu.bd,https://www.narinda.sjis.edu.bd,http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL Production Database ---
POSTGRES_DB=sjis_narinda_db
POSTGRES_USER=sjis_user
POSTGRES_PASSWORD=sjis_prod_db_pass_2026!
DATABASE_URL=postgres://sjis_user:sjis_prod_db_pass_2026!@db:5432/sjis_narinda_db

# --- Initial Administrator Superuser Credentials ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=sjisadmin2026
DJANGO_SUPERUSER_EMAIL=admin@sjis-narinda.edu.bd

# --- Gunicorn & Process Concurrency ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Next.js Frontend ---
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:8000/api
